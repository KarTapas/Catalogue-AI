PORT=3000
FAKESTORE_BASE_URL=https://fakestoreapi.com
# Comma-separated positive product IDs; leave empty to use rating-based defaults.
FEATURED_IDS=1,2,3,4,5
SALES_INBOX=sales@example.test
EMAIL_FROM=catalogue@example.test
SMTP_HOST=mailpit
SMTP_PORT=1025
# Supported providers: console, smtp.
EMAIL_PROVIDER=console
